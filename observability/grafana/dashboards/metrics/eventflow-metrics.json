      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"editorMode": "code", "expr": "sum(rate(eventflow_http_requests_total{route=~\"$route\",status=~\"$status\"}[$interval]))", "legendFormat": "Toplam trafik", "range": true, "refId": "A"}],
      "title": "İstek trafiği",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "eventflow-prometheus"},
