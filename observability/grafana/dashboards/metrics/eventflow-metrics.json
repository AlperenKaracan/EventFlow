      "targets": [
        {"editorMode": "code", "expr": "topk(5, histogram_quantile(0.95, sum by (le, route) (rate(eventflow_http_request_duration_seconds_bucket{route=~\"$route\",route!=\"unmatched\"}[$interval]))))", "legendFormat": "{{route}}", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(eventflow_http_request_duration_seconds_bucket{route=~\"$route\",route=\"unmatched\"}[$interval])))", "legendFormat": "Eşleşmeyen rota (404)", "range": true, "refId": "B"}
      ],
      "title": "En yavaş rotalar",
      "type": "bargauge"
    },
    {
