      "targets": [
        {"editorMode": "code", "expr": "histogram_quantile(0.50, sum by (le) (rate(eventflow_http_request_duration_seconds_bucket{route=~\"$route\"}[$interval])))", "legendFormat": "p50", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(eventflow_http_request_duration_seconds_bucket{route=~\"$route\"}[$interval])))", "legendFormat": "p95", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "histogram_quantile(0.99, sum by (le) (rate(eventflow_http_request_duration_seconds_bucket{route=~\"$route\"}[$interval])))", "legendFormat": "p99", "range": true, "refId": "C"}
      ],
      "title": "İstek gecikmesi yüzdelikleri",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "eventflow-prometheus"},
      "description": "p95 gecikmesine göre en yavaş rota şablonlarını sıralar. Kayıtlı bir rota şablonuyla eşleşmeyen 404 istekleri ayrı ve anlaşılır bir adla sunulur.",
      "fieldConfig": {"defaults": {"color": {"mode": "continuous-GrYlRd"}, "decimals": 3, "noValue": "Veri yok", "unit": "s"}, "overrides": []},
