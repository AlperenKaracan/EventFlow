      "options": {"displayLabels": ["name", "percent"], "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"]}, "pieType": "donut", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"editorMode": "code", "expr": "sum by (status) (rate(eventflow_http_requests_total{route=~\"$route\",status=~\"$status\"}[$interval]))", "legendFormat": "HTTP {{status}}", "range": true, "refId": "A"}],
      "title": "HTTP durum dağılımı",
      "type": "piechart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "eventflow-prometheus"},
      "description": "Seçili rotalar için p50, p95 ve p99 istek gecikmesini gösterir.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 8, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never"}, "decimals": 3, "noValue": "Veri yok", "unit": "s"}, "overrides": []},
