# Runtime mode: development, test, or production.
APP_ENV=development

# PostgreSQL container bootstrap values. Replace outside local development.
POSTGRES_DB=eventflow
POSTGRES_USER=eventflow
POSTGRES_PASSWORD=eventflow_local_password

# Async application and Redis connection strings used inside Compose.
DATABASE_URL=postgresql+asyncpg://eventflow:eventflow_local_password@db:5432/eventflow
REDIS_URL=redis://redis:6379/0

# Development-only JWT secret. Production rejects this demo value.
JWT_SECRET=development-only-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Exact comma-separated browser origins; wildcard is rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Structured logging and rate-limit configuration.
LOG_LEVEL=INFO
LOGIN_RATE_LIMIT_PER_MINUTE=5
RESERVATION_RATE_LIMIT_PER_MINUTE=10

# Dependency and shutdown timeouts in seconds.
DEPENDENCY_TIMEOUT_SECONDS=2
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=20

# Browser-visible local URLs.
FRONTEND_PUBLIC_URL=http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:8000

# Local demo users. Seed hashes these with Argon2id and never logs them.
SEED_ORGANIZER_PASSWORD=OrganizerDemo123!
SEED_ATTENDEE_PASSWORD=AttendeeDemo123!
